---
import { woodProduct } from "../../content/wood";
---

<section class="product-delivery">
  <div class="container delivery-grid">
    <div class="delivery-copy">
      <span>Livraison</span>
      <h2>{woodProduct.delivery.title}</h2>
      <p>{woodProduct.delivery.description}</p>
    </div>

    <div class="delivery-steps">
      <div class="delivery-step">
        <span>01</span>
        <div><strong>Votre demande</strong><p>Indiquez la quantité et votre adresse.</p></div>
      </div>
      <div class="delivery-step">
        <span>02</span>
        <div><strong>Confirmation</strong><p>Nous précisons les conditions de livraison.</p></div>
      </div>
      <div class="delivery-step">
        <span>03</span>
        <div><strong>Livraison</strong><p>Votre bois est livré en vrac à l'endroit convenu.</p></div>
      </div>
    </div>
  </div>
</section>
