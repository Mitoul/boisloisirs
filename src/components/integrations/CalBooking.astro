---
export interface Props {
  label?: string;
}

const { label = "Prendre rendez-vous" } = Astro.props;

// Liste des types de rendez-vous proposés.
// Pour ajouter une nouvelle prestation plus tard, ajoutez simplement un objet ici :
// { id, icon, title, description, calLink, calNamespace }
const rdvOptions = [
  {
    id: "mazout",
    icon: "🛢️",
    title: "Entretien chaudière mazout",
    description: "Entretien annuel obligatoire de votre chaudière au mazout.",
    // TODO : remplacer par le bon lien Cal.com une fois le compte client lié
    calLink: "michael-boelen-qo8rcj/devis",
    calNamespace: "mazout",
  },
  {
    id: "gaz",
    icon: "🔥",
    title: "Entretien chaudière gaz",
    description: "Entretien annuel obligatoire de votre chaudière au gaz.",
    // TODO : remplacer par le bon lien Cal.com une fois le compte client lié
    calLink: "michael-boelen-qo8rcj/decouvert",
    calNamespace: "gaz",
  },
];
---

<button type="button" class="cal-trigger-btn" id="cal-open-btn">
  {label}
</button>

<dialog id="cal-modal" class="cal-modal">
  <div class="cal-modal-content">
    <button type="button" class="cal-modal-close" id="cal-close-btn" aria-label="Fermer">
      ✕
    </button>

    <h2 class="cal-modal-title">Quel type de rendez-vous souhaitez-vous ?</h2>
    <p class="cal-modal-subtitle">
      Choisissez la prestation pour accéder directement au calendrier de disponibilités.
    </p>

    <div class="cal-options-grid">
      {
        rdvOptions.map((option) => (
          <button
            type="button"
            class="cal-option-card"
            data-cal-namespace={option.calNamespace}
            data-cal-link={option.calLink}
            data-cal-config={JSON.stringify({ layout: "month_view" })}
          >
            <span class="cal-option-icon" aria-hidden="true">
              {option.icon}
            </span>
            <span class="cal-option-title">{option.title}</span>
            <span class="cal-option-desc">{option.description}</span>
            <span class="cal-option-cta">Choisir ce créneau →</span>
          </button>
        ))
      }
    </div>
  </div>
</dialog>

<script define:vars={{ options: rdvOptions }}>
  // Évite une double initialisation si le composant est malgré tout inclus deux fois
  if (!window.__calBookingInitialized) {
    window.__calBookingInitialized = true;

    // Snippet officiel d'embed Cal.com
    (function (C, A, L) {
      let p = function (a, ar) {
        a.q.push(ar);
      };
      let d = C.document;
      C.Cal =
        C.Cal ||
        function () {
          let cal = C.Cal;
          let ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () {
              p(api, arguments);
            };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === "string") {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ["initNamespace", namespace]);
            } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
    })(window, "https://app.cal.com/embed/embed.js", "init");

    // Initialise un namespace Cal.com distinct par type de rendez-vous
    options.forEach((option) => {
      window.Cal("init", option.calNamespace, { origin: "https://cal.com" });
      window.Cal.ns[option.calNamespace]("ui", {
        styles: { branding: { brandColor: "#1474c4" } },
        hideEventTypeDetails: false,
        layout: "month_view",
      });
    });
  }

  // Gestion de la modale de choix (ouverture / fermeture)
  const modal = document.getElementById("cal-modal");
  const openBtn = document.getElementById("cal-open-btn");
  const closeBtn = document.getElementById("cal-close-btn");

  openBtn?.addEventListener("click", () => modal?.showModal());
  closeBtn?.addEventListener("click", () => modal?.close());

  // Ferme la modale si on clique en dehors du contenu (sur le backdrop)
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) modal.close();
  });

  // Ferme la modale de choix juste après avoir cliqué sur une prestation,
  // pour ne pas avoir la modale de choix + le popup Cal.com superposés
  document.querySelectorAll(".cal-option-card").forEach((btn) => {
    btn.addEventListener("click", () => {
      setTimeout(() => modal?.close(), 150);
    });
  });
</script>
