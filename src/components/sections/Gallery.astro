---
import SectionTitle from "../ui/SectionTitle.astro";
import { gallery } from "../../content/gallery";
import { chantiers } from "../../content/chantiers";

const featured = chantiers.filter((c) => c.featured);
---

{
  gallery.enabled && (
    <section id="gallery" class="gallery">
      <div class="container">
        <SectionTitle title={gallery.title} subtitle={gallery.subtitle} />

        <div class="gallery-grid" id="home-chantiers" data-static={chantiers.map((c) => c.slug).join(",")}>
          {featured.map((c) => (
            <a class="gallery-card" href={`/realisations/${c.slug}/`}>
              <div class="gallery-image">
                <img src={c.cover} alt={c.title} loading="lazy" decoding="async" />
              </div>
              <div class="gallery-content">
                <span>{c.category}</span>
                <h3>{c.title}</h3>
              </div>
            </a>
          ))}
        </div>

        <p class="gallery-more"><a class="btn btn-primary" href="/realisations/">Voir toutes nos réalisations</a></p>
      </div>
    </section>
  )
}

<script>
  import { loadChantiers, cardHtml } from "../../lib/realisations-live";
  const grid = document.getElementById("home-chantiers");
  if (grid) {
    const known = (grid.dataset.static || "").split(",");
    loadChantiers().then((list) => {
      if (!list) return;
      const featured = list.filter((c) => c.featured).slice(0, 4);
      if (!featured.length) return;
      grid.innerHTML = featured
        .map((c) => cardHtml(c, known.includes(c.slug) ? `/realisations/${c.slug}/` : `/realisations/voir/?s=${encodeURIComponent(c.slug)}`, { showCount: false, summary: false }))
        .join("");
    });
  }
</script>
