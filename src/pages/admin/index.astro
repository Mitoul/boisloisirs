---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Portail client | Bois Loisirs" description="Administration du contenu Bois Loisirs" noindex>
  <div class="admin-page">
    <div class="container admin-shell">
      <section id="login-panel" class="admin-card">
        <p class="eyebrow">Portail client</p>
        <h1>Administration du site</h1>
        <p>Connectez-vous pour modifier le prix du bois, les photos des produits et les réalisations.</p>
        <form id="login-form" class="admin-form">
          <label>Email<input id="login-email" type="email" required autocomplete="email" /></label>
          <label>Mot de passe<input id="login-password" type="password" required autocomplete="current-password" /></label>
          <button type="submit" class="admin-button">Se connecter</button>
          <p id="login-status" class="admin-status" role="status"></p>
        </form>
      </section>

      <section id="dashboard" class="admin-card" hidden>
        <div class="admin-header">
          <div>
            <p class="eyebrow">Portail client</p>
            <h1>Gestion du contenu</h1>
          </div>
          <button id="logout" class="admin-button secondary">Se déconnecter</button>
        </div>

        <div class="admin-section">
          <h2>Prix du bois de chauffage</h2>
          <div class="admin-grid two">
            <label>Jusqu’à 2 stères (€ / stère)<input id="price-small" type="number" min="0" step="0.01" /></label>
            <label>À partir de 3 stères (€ / stère)<input id="price-large" type="number" min="0" step="0.01" /></label>
          </div>
          <button id="save-prices" class="admin-button">Enregistrer les prix</button>
          <p id="price-status" class="admin-status" role="status"></p>
        </div>

        <div class="admin-section">
          <h2>Photos</h2>
          <p class="admin-muted">Remplacez les visuels principaux du bois et des pellets. Les fichiers sont stockés dans Supabase Storage.</p>
          <div class="admin-media-grid">
            <article class="media-card">
              <h3>Bois — photo principale</h3>
              <img id="wood-preview" alt="Aperçu bois" />
              <input id="wood-image" type="file" accept="image/jpeg,image/png,image/webp" />
              <button class="admin-button" data-upload="wood-hero">Remplacer la photo</button>
              <p id="wood-status" class="admin-status"></p>
            </article>
            <article class="media-card">
              <h3>Pellets — photo principale</h3>
              <img id="pellets-preview" alt="Aperçu pellets" />
              <input id="pellets-image" type="file" accept="image/jpeg,image/png,image/webp" />
              <button class="admin-button" data-upload="pellets-hero">Remplacer la photo</button>
              <p id="pellets-status" class="admin-status"></p>
            </article>
          </div>
        </div>

        <div class="admin-section">
          <h2>Réalisations</h2>
          <p class="admin-muted">Créez un chantier, ajoutez ses photos (avant, pendant, après) puis cochez « Visible sur le site ». Les photos sont réduites automatiquement. Les changements apparaissent tout de suite sur le site.</p>
          <form id="chantier-form" class="admin-form chantier-new">
            <div class="admin-grid two">
              <label>Titre du nouveau chantier<input id="new-title" required minlength="3" maxlength="120" placeholder="Ex. Abattage à Chastre" /></label>
              <label>Catégorie
                <select id="new-category">
                  <option>Abattage</option><option>Nivellement</option><option>Terrassement</option><option>Aménagement extérieur</option><option>Autre</option>
                </select>
              </label>
            </div>
            <label>Description courte<textarea id="new-summary" maxlength="400" rows="2" placeholder="Une ou deux phrases sur le chantier"></textarea></label>
            <button type="submit" class="admin-button">Créer le chantier</button>
          </form>
          <p id="chantier-status" class="admin-status" role="status"></p>
          <div id="chantiers-admin" class="chantiers-admin">Chargement…</div>
        </div>

        <div class="admin-section">
          <h2>Demandes reçues</h2>
          <div id="requests-list" class="requests-list">Chargement…</div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  import "../../scripts/admin.js";
</script>
