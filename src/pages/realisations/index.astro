---
import Layout from "../../layouts/Layout.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";
import { chantiers } from "../../content/chantiers";
---
<Layout title="Nos réalisations — Bois, Aménagements & Loisirs" description="Suivez l'évolution de nos chantiers en photos : terrassement, nivellement, abattage, aménagements extérieurs en Brabant wallon.">
  <section class="gallery">
    <div class="container">
      <SectionTitle level={1} title="Nos réalisations" subtitle="Suivez l'évolution de nos chantiers, de l'état initial au résultat final." />
      <div class="gallery-grid" id="chantiers-grid" data-static={chantiers.map((c) => c.slug).join(",")}>
        {chantiers.map((c) => (
          <a class="gallery-card" href={`/realisations/${c.slug}/`}>
            <div class="gallery-image"><img src={c.cover} alt={c.title} loading="lazy" decoding="async" /></div>
            <div class="gallery-content">
              <span>{c.category}</span>
              <h2>{c.title}</h2>
              <p>{c.summary}</p>
              {c.photos.length > 1 && <small>{c.photos.length} photos</small>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  import { loadChantiers, cardHtml } from "../../lib/realisations-live";
  const grid = document.getElementById("chantiers-grid")!;
  const known = (grid.dataset.static || "").split(",");
  loadChantiers().then((list) => {
    if (!list) return;
    grid.innerHTML = list
      .map((c) => cardHtml(c, known.includes(c.slug) ? `/realisations/${c.slug}/` : `/realisations/voir/?s=${encodeURIComponent(c.slug)}`))
      .join("");
  });
</script>
