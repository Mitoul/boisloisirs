---
import Layout from "../../layouts/Layout.astro";
import Lightbox from "../../components/realisations/Lightbox.astro";
import { chantiers, phases } from "../../content/chantiers";

export function getStaticPaths() {
  return chantiers.map((c) => ({ params: { slug: c.slug }, props: { chantier: c } }));
}
const { chantier } = Astro.props;
const order = Object.keys(phases);
const hasPhases = chantier.photos.some((x) => x.phase);
const byPhase = hasPhases
  ? order
      .map((p) => ({ key: p, label: phases[p], photos: chantier.photos.filter((x) => x.phase === p) }))
      .filter((g) => g.photos.length)
  : [{ key: "all", label: "", photos: chantier.photos }];
---
<Layout title={`${chantier.title} — Réalisations`} description={chantier.summary}>
  <section class="gallery chantier">
    <div class="container">
      <p><a href="/realisations/">← Toutes les réalisations</a></p>
      <span class="chantier-cat" id="chantier-cat">{chantier.category}</span>
      <h1 id="chantier-title">{chantier.title}</h1>
      <p id="chantier-summary">{chantier.summary}</p>

      <div id="timeline-root" data-slug={chantier.slug}>
      <ol class="timeline">
        {byPhase.map((g) => (
          <li class="timeline-step">
            {g.label && <h2>{g.label}</h2>}
            <div class="timeline-photos">
              {g.photos.map((p) => (
                <a href={p.src} data-lightbox data-alt={p.alt} data-caption={g.label ? `${g.label} — ${p.alt}` : p.alt}>
                  <img src={p.src} alt={p.alt} loading="lazy" decoding="async" />
                </a>
              ))}
            </div>
          </li>
        ))}
      </ol>
      </div>
    </div>
  </section>
  <Lightbox />
</Layout>

<script>
  import { loadChantiers, timelineHtml } from "../../lib/realisations-live";
  const root = document.getElementById("timeline-root")!;
  loadChantiers().then((list) => {
    const c = list?.find((x) => x.slug === root.dataset.slug);
    if (!c) return;
    root.innerHTML = timelineHtml(c);
    document.getElementById("chantier-cat")!.textContent = c.category;
    document.getElementById("chantier-title")!.textContent = c.title;
    document.getElementById("chantier-summary")!.textContent = c.summary;
  });
</script>
